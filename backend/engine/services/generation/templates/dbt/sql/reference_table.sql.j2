[# Reference Table Template #]
[# Generates a reference table that combines a reference hub with its satellites #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% for key, value in (model_config or {}).items() %]
    [[ key ]]=[[ value ]],
[% endfor %]
    tags=[% if model_tags %][[ model_tags ]][% else %]['reference_table', 'raw_vault'][% endif +%]
) }}

{%- set yaml_metadata -%}
ref_hub: [[ reference_hub_name ]]
ref_satellites:
[% for sat in satellites %]
    [[ satellite_models[sat.satellite_name] ]]:
    [% if sat.include_columns %]
      include:
        [% for col in sat.include_columns %]
        - [[ col ]]
        [% endfor %]
    [% endif %]
    [% if sat.exclude_columns %]
      exclude:
        [% for col in sat.exclude_columns %]
        - [[ col ]]
        [% endfor %]
    [% endif %]
[% endfor %]
historized: '[[ "full" if historization_type == "full" else "latest" ]]'
{%- endset -%}

{{ datavault4dbt.ref_table(yaml_metadata=yaml_metadata) }}
