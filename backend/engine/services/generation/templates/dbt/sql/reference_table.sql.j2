[# Reference Table Template #]
[# Generates a reference table that combines a reference hub with its satellites #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% if model_alias %]
    alias='[[ model_alias ]]',
[% endif %]
[% if model_schema %]
    schema='[[ model_schema ]]',
[% endif %]
[% if model_database %]
    database='[[ model_database ]]',
[% endif %]
[% for key, value in (model_custom_config | default({})).items() %]
    [[ key ]]=[[ value | config_literal ]],
[% endfor %]
    tags=[% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['reference_table', 'raw_vault'][% endif +%]
) }}

{%- set yaml_metadata -%}
ref_hub: [[ reference_hub_name ]]
ref_satellites:
[% for sat in satellites %]
    [[ sat.v1_name ]]:
    [% if sat.include_columns %]
      include:
        [% for col in sat.include_columns %]
        - [[ col ]]
        [% endfor %]
    [% endif %]
    [% if sat.exclude_columns %]
      exclude:
        [% for col in sat.exclude_columns %]
        - [[ col ]]
        [% endfor %]
    [% endif %]
[% endfor %]
historized: '[[ "full" if historization_type == "full" else "latest" ]]'
{%- endset -%}

{{ datavault4dbt.ref_table(yaml_metadata=yaml_metadata) }}
