[# Reference Hub Template #]
[# Generates a reference hub model using datavault4dbt.ref_hub() macro #]
[# model_config: the config() block; the hub's stored settings override these defaults #]
[[ model_config(materialized=materialization, tags=['hub', 'reference', 'raw_vault', (group | technical_name) if group else none]) ]]

{%- set yaml_metadata -%}
source_models:
[% for source in source_tables %]
    - name: [[ source.stage_name ]]
[% if source.rsrc_static %]
      rsrc_static: [[ source.rsrc_static | yaml_quote ]]
[% endif %]
[% if source.business_key_columns %]
      ref_keys: 
    [% for rk in source.business_key_columns %]
        - [[ rk | yaml_scalar ]]
    [% endfor %]
[% endif %]
[% endfor %]
ref_keys:
[% for rk in reference_key_columns %]
    - [[ rk | yaml_scalar ]]
[% endfor %]
[% if additional_columns %]
additional_columns:
[% for col in additional_columns %]
    - [[ col ]]
[% endfor %]
[% endif %]
{%- endset -%}

{{ datavault4dbt.ref_hub(yaml_metadata=yaml_metadata) }}
