[# Reference Hub Template #]
[# Generates a reference hub model using datavault4dbt.ref_hub() macro #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% if model_alias %]
    alias='[[ model_alias ]]',
[% endif %]
[% if model_schema %]
    schema='[[ model_schema ]]',
[% endif %]
[% if model_database %]
    database='[[ model_database ]]',
[% endif %]
    tags=[% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['hub', 'reference', 'raw_vault'[% if group %], '[[ group ]]'[% endif %]][% endif +%]
) }}

{%- set yaml_metadata -%}
source_models:
[% for source in source_tables %]
    - name: [[ source.stage_name ]]
[% if source.rsrc_static %]
      rsrc_static: [[ source.rsrc_static | yaml_quote ]]
[% endif %]
[% if source.business_key_columns %]
      ref_keys: 
    [% for rk in source.business_key_columns %]
        - [[ rk ]]
    [% endfor %]
[% endif %]
[% endfor %]
ref_keys:
[% for rk in reference_key_columns %]
    - [[ rk ]]
[% endfor %]
{%- endset -%}

{{ datavault4dbt.ref_hub(yaml_metadata=yaml_metadata) }}
