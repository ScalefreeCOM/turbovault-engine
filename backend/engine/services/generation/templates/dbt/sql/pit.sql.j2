[# PIT (Point-In-Time) Template #]
[# Generates a PIT structure for dimensional views #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% if model_alias %]
    alias='[[ model_alias ]]',
[% endif %]
[% if model_schema %]
    schema='[[ model_schema ]]',
[% endif %]
[% if model_database %]
    database='[[ model_database ]]',
[% endif %]
[% for key, value in (model_custom_config | default({})).items() %]
    [[ key ]]=[[ value | config_literal ]],
[% endfor %]
    tags=[% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['pit', 'business_vault'][% endif %],
[# A post_hook in custom_config_json replaces the default clean-up hook #]
[% if 'post_hook' not in model_custom_config | default({}) %]
    post_hook="{{ datavault4dbt.clean_up_pit('[[ snapshot_control_name ]]') }}"
[% endif %]
) }}

{%- set yaml_metadata -%}
[% if pit_type %]
pit_type: '[[ pit_type ]]'
[% endif %]
tracked_entity: [[ tracked_entity_name ]]
hashkey: [[ tracked_hashkey ]]
sat_names:
[# satellite_v0_names: the v0 model of each satellite in `satellites` #]
[% for sat in satellite_v0_names %]
    - [[ sat ]]
[% endfor %]
snapshot_relation: [[ snapshot_control_name ]]
snapshot_trigger_column: [[ snapshot_logic_column ]]
[% if dimension_key_column %]
dimension_key: [[ dimension_key_column ]]
[% endif %]
{%- endset -%}

{{ datavault4dbt.pit(yaml_metadata=yaml_metadata) }}
