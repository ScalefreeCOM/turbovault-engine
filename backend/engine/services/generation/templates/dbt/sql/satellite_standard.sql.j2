[# Standard Satellite Template #]
[# Generates a satellite model using datavault4dbt.sat_v0() macro #]
[# model_config: the config() block; the satellite's stored settings override these defaults #]
[[ model_config(materialized=materialization, tags=['satellite', 'raw_vault', (group | technical_name) if group else none]) ]]

{%- set yaml_metadata -%}
source_model: [[ stage_name ]]
parent_hashkey: [[ parent_hashkey ]]
[# hashdiff_alias: the hash diff's name inside the satellite, when it differs from the stage's #]
[% if hashdiff_alias %]
src_hashdiff:
    source_column: [[ hashdiff_name ]]
    alias: [[ hashdiff_alias ]]
[% else %]
src_hashdiff: [[ hashdiff_name ]]
[% endif %]
src_payload:
[% for col in columns %]
    - [[ (col.target_column_name if col.target_column_name else col.source_column) | yaml_scalar ]]
[% endfor %]
[% if disable_hwm %]
disable_hwm: true
[% endif %]
[# source_is_single_batch: the stage delivers single batches (delivery method) #]
[% if source_is_single_batch %]
source_is_single_batch: true
[% endif %]
{%- endset -%}

{{ datavault4dbt.sat_v0(yaml_metadata=yaml_metadata) }}
