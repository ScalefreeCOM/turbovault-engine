[# Standard Satellite Template #]
[# Generates a satellite model using datavault4dbt.sat_v0() macro #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% if model_alias %]
    alias='[[ model_alias ]]',
[% endif %]
[% if model_schema %]
    schema='[[ model_schema ]]',
[% endif %]
[% if model_database %]
    database='[[ model_database ]]',
[% endif %]
    tags=[% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['satellite', 'raw_vault'[% if group %], '[[ group ]]'[% endif %]][% endif +%]
) }}

{%- set yaml_metadata -%}
source_model: [[ stage_name ]]
parent_hashkey: [[ parent_hashkey ]]
src_hashdiff: [[ hashdiff_name ]]
src_payload:
[% for col in columns %]
    - [[ col.target_column_name if col.target_column_name else col.source_column ]]
[% endfor %]
{%- endset -%}

{{ datavault4dbt.sat_v0(yaml_metadata=yaml_metadata) }}
