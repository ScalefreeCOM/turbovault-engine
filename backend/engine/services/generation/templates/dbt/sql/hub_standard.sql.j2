[# Standard Hub Template #]
[# Generates a standard hub model using datavault4dbt.hub() macro #]
[# model_config: the config() block; the hub's stored settings override these defaults #]
[[ model_config(materialized=materialization, tags=['hub', 'raw_vault', (group | technical_name) if group else none]) ]]

{%- set yaml_metadata -%}
source_models:
[% for source in source_tables %]
    - name: [[ source.stage_name ]]
[% if source.rsrc_static %]
      rsrc_static: [[ source.rsrc_static | yaml_quote ]]
[% endif %]
[# hk_column: the stage hash key this source loads, when it isn't the hub's (role-playing) #]
[% if source.hk_column and source.hk_column != hashkey.hashkey_name %]
      hk_column: [[ source.hk_column ]]
[% endif %]
[% if source.business_key_columns %]
      bk_columns:
[% for bk in source.business_key_columns %]
          - [[ bk | yaml_scalar ]]
[% endfor %]
[% endif %]
[% endfor %]
hashkey: [[ hashkey.hashkey_name ]]
business_keys:
[% for bk in business_key_columns %]
    - [[ bk | yaml_scalar ]]
[% endfor %]
[% if additional_columns %]
additional_columns:
[% for col in additional_columns %]
    - [[ col ]]
[% endfor %]
[% endif %]
[% if disable_hwm %]
disable_hwm: true
[% endif %]
{%- endset -%}

{{ datavault4dbt.hub(yaml_metadata=yaml_metadata) }}
