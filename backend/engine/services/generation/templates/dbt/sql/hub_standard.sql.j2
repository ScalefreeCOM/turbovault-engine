[# Standard Hub Template #]
[# Generates a standard hub model using datavault4dbt.hub() macro #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% if model_alias %]
    alias='[[ model_alias ]]',
[% endif %]
[% if model_schema %]
    schema='[[ model_schema ]]',
[% endif %]
[% if model_database %]
    database='[[ model_database ]]',
[% endif %]
    tags=[% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['hub', 'raw_vault'[% if group %], '[[ group ]]'[% endif %]][% endif +%]
) }}

{%- set yaml_metadata -%}
source_models:
[% for source in source_tables %]
    - name: [[ source.stage_name ]]
[% if source.rsrc_static %]
      rsrc_static: [[ source.rsrc_static | yaml_quote ]]
[% endif %]
[% if source.business_key_columns %]
      bk_columns:
[% for bk in source.business_key_columns %]
          - [[ bk ]]
[% endfor %]
[% endif %]
[% endfor %]
hashkey: [[ hashkey.hashkey_name ]]
business_keys:
[% for bk in business_key_columns %]
    - [[ bk ]]
[% endfor %]
{%- endset -%}

{{ datavault4dbt.hub(yaml_metadata=yaml_metadata) }}