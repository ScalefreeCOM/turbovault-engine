[# Snapshot Control V0 Template #]
[# Generates the snapshot control table with date ranges #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% if model_alias %]
    alias='[[ model_alias ]]',
[% endif %]
[% if model_schema %]
    schema='[[ model_schema ]]',
[% endif %]
[% if model_database %]
    database='[[ model_database ]]',
[% endif %]
[% for key, value in (model_custom_config | default({})).items() %]
    [[ key ]]=[[ value | config_literal ]],
[% endfor %]
    tags=[% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['snapshot_control', 'control'][% endif +%]
) }}

{%- set yaml_metadata -%}
start_date: '[[ start_date ]]'
daily_snapshot_time: '[[ daily_time ]]'
{%- endset -%}

{{ datavault4dbt.control_snap_v0(yaml_metadata=yaml_metadata) }}
