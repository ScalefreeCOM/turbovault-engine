[# Non-Historized Link Template #]
[# Generates a non-historized link model using datavault4dbt.nh_link() macro #]
[# model_config: the config() block; the link's stored settings override these defaults #]
[[ model_config(materialized=materialization, tags=['link', 'non_historized', 'raw_vault', group]) ]]

{%- set yaml_metadata -%}
source_models:
[% for source in source_tables %]
    - name: [[ source.stage_name ]]
[% if source.rsrc_static %]
      rsrc_static: [[ source.rsrc_static | yaml_quote ]]
[% endif %]
[% if source.link_hk and source.link_hk != hashkey.hashkey_name %]
      link_hk: [[ source.link_hk ]]
[% endif %]
[% if source.fk_columns %]
      fk_columns:
[% for fk in source.fk_columns %]
          - [[ fk ]]
[% endfor %]
[% endif %]
[% endfor %]
link_hashkey: [[ hashkey.hashkey_name ]]
foreign_hashkeys:
[% for fk in foreign_hashkeys %]
    - [[ fk ]]
[% endfor %]
[% if payload_columns %]
payload:
[% for col in payload_columns %]
    - [[ col ]]
[% endfor %]
[% endif %]
[% if additional_columns %]
additional_columns:
[% for col in additional_columns %]
    - [[ col ]]
[% endfor %]
[% endif %]
[% if disable_hwm %]
disable_hwm: true
[% endif %]
[# source_is_single_batch: every source stage delivers single batches (delivery method) #]
[% if source_is_single_batch %]
source_is_single_batch: true
[% endif %]
[% if union_strategy %]
union_strategy: [[ union_strategy ]]
[% endif %]
{%- endset -%}

{{ datavault4dbt.nh_link(yaml_metadata=yaml_metadata) }}
