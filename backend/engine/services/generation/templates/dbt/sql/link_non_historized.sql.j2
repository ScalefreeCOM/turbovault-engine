[# Non-Historized Link Template #]
[# Generates a non-historized link model using datavault4dbt.nh_link() macro #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% if model_alias %]
    alias='[[ model_alias ]]',
[% endif %]
[% if model_schema %]
    schema='[[ model_schema ]]',
[% endif %]
[% if model_database %]
    database='[[ model_database ]]',
[% endif %]
    tags=[% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['link', 'non_historized', 'raw_vault'[% if group %], '[[ group ]]'[% endif %]][% endif +%]
) }}

{%- set yaml_metadata -%}
source_models:
[% for source in source_tables %]
    - name: [[ source.stage_name ]]
[% if source.rsrc_static %]
      rsrc_static: [[ source.rsrc_static | yaml_quote ]]
[% endif %]
[% if source.link_hk and source.link_hk != hashkey.hashkey_name %]
      link_hk: [[ source.link_hk ]]
[% endif %]
[% if source.fk_columns %]
      fk_columns:
[% for fk in source.fk_columns %]
          - [[ fk ]]
[% endfor %]
[% endif %]
[% endfor %]
link_hashkey: [[ hashkey.hashkey_name ]]
foreign_hashkeys:
[% for fk in foreign_hashkeys %]
    - [[ fk ]]
[% endfor %]
[% if payload_columns %]
payload:
[% for col in payload_columns %]
    - [[ col ]]
[% endfor %]
[% endif %]
{%- endset -%}

{{ datavault4dbt.nh_link(yaml_metadata=yaml_metadata) }}
