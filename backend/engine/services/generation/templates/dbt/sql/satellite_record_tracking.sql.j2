[# Record Tracking Satellite Template #]
[# Tracks the presence/absence of business objects in source systems #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% if model_alias %]
    alias='[[ model_alias ]]',
[% endif %]
[% if model_schema %]
    schema='[[ model_schema ]]',
[% endif %]
[% if model_database %]
    database='[[ model_database ]]',
[% endif %]
    tags=[% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['satellite', 'record_tracking', 'raw_vault'[% if group %], '[[ group ]]'[% endif %]][% endif +%]
) }}

{%- set yaml_metadata -%}
source_models:
[% for source in source_tables %]
    - name: [[ source.stage_name ]]
[% if source.rsrc_static %]
      rsrc_static: [[ source.rsrc_static | yaml_quote ]]
[% endif %]
[% if source.hk_column and source.hk_column != parent_hashkey %]
      hk_column: [[ source.hk_column ]]
[% endif %]
[% endfor %]
tracked_hashkey: [[ parent_hashkey ]]
{%- endset -%}

{{ datavault4dbt.rec_track_sat(yaml_metadata=yaml_metadata) }}
