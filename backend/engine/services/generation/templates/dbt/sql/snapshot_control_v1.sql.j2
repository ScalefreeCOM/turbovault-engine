[# Snapshot Control V1 Template #]
[# Generates the snapshot control logic with retention patterns #]

[# v0_name: the snapshot control table model this logic reads #]

[# model_config: the config() block; the model's stored settings override these defaults #]
[[ model_config(materialized=materialization, tags=['snapshot_control', 'control']) ]]

[# log_logic_columns: the logic columns and their datavault4dbt intervals (daily, weekly, monthly, yearly) #]
[# log_logic_mapping: one column named like the trigger column variable, written as a mapping #]
{%- set yaml_metadata -%}
control_snap_v0: [[ v0_name ]]
[% if log_logic_columns %]
log_logic:
[% if log_logic_mapping %]
[% for interval in log_logic_columns[0].intervals %]
    [[ interval.name ]]:
[% if interval.forever %]
        forever: true
[% else %]
        duration: [[ interval.duration ]]
        unit: '[[ interval.unit ]]'
[% endif %]
[% endfor %]
[% else %]
[% for column in log_logic_columns %]
    - [[ column.name ]]:
[% for interval in column.intervals %]
        [[ interval.name ]]:
[% if interval.forever %]
            forever: true
[% else %]
            duration: [[ interval.duration ]]
            unit: '[[ interval.unit ]]'
[% endif %]
[% endfor %]
[% endfor %]
[% endif %]
[% endif %]
[% if sdts_alias %]
sdts_alias: [[ sdts_alias ]]
[% endif %]
{%- endset -%}

{{ datavault4dbt.control_snap_v1(yaml_metadata=yaml_metadata) }}
