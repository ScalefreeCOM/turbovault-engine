[# Snapshot Control V1 Template #]
[# Generates the snapshot control logic with retention patterns #]

[# v0_name: model name of the snapshot control v0 model this one reads #]
{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% if model_alias %]
    alias='[[ model_alias ]]',
[% endif %]
[% if model_schema %]
    schema='[[ model_schema ]]',
[% endif %]
[% if model_database %]
    database='[[ model_database ]]',
[% endif %]
    tags=[% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['snapshot_control', 'control'][% endif +%]
) }}

{%- set yaml_metadata -%}
control_snap_v0: [[ v0_name ]]
log_logic:
[% for pattern in logic_patterns %]
    [[ pattern.component ]]:
[% if pattern.forever %]
        forever: true
[% else %]
        duration: [[ pattern.duration ]]
        unit: '[[ pattern.unit ]]'
[% endif %]
[% endfor %]
{%- endset -%}

{{ datavault4dbt.control_snap_v1(yaml_metadata=yaml_metadata) }}
