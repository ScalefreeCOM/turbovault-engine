[# Snapshot Control V1 Template #]
[# Generates the snapshot control logic with retention patterns #]

{{ config(
[% if materialization %]
    materialized='[[ materialization ]]',
[% endif %]
[% for key, value in (model_config or {}).items() %]
    [[ key ]]=[[ value ]],
[% endfor %]
    tags=[% if model_tags %][[ model_tags ]][% else %]['snapshot_control', 'control'][% endif +%]
) }}

{%- set yaml_metadata -%}
control_snap_v0: [[ control_v0_name ]]
log_logic:
[% for pattern in logic_patterns %]
    [[ pattern.component ]]:
[% if pattern.forever %]
        forever: true
[% else %]
        duration: [[ pattern.duration ]]
        unit: '[[ pattern.unit ]]'
[% endif %]
[% endfor %]
{%- endset -%}

{{ datavault4dbt.control_snap_v1(yaml_metadata=yaml_metadata) }}
