[# Pre-Stage Model YAML Schema Template #]
[# Documents the columns the pre-stage provides, as declared in the metadata. #]
version: 2

models:
  - name: [[ model_name ]]
    description: [[ (description or ("Pre-stage model for " ~ table_name ~ " from " ~ source_system)) | yaml_quote ]]
    config:
[# The model's SQL may set its own config(), which dbt ranks above this block #]
[% if materialization %]
      materialized: [[ materialization | yaml_scalar ]]
[% endif %]
[% if model_alias %]
      alias: [[ model_alias | yaml_scalar ]]
[% endif %]
[% if model_schema %]
      schema: [[ model_schema | yaml_scalar ]]
[% endif %]
[% if model_database %]
      database: [[ model_database | yaml_scalar ]]
[% endif %]
[% for key, value in (model_custom_config | default({})).items() %]
      [[ key ]]: [[ value | yaml_json ]]
[% endfor %]
      tags: [% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['prestage', '[[ source_system | lower | replace(" ", "_") ]]'][% endif +%]
[% if columns %]
    columns:
[% for column in columns %]
      - name: [[ column.column_name ]]
[% if column.datatype %]
        data_type: [[ column.datatype | yaml_scalar ]]
[% endif %]
[% if column.description %]
        description: [[ column.description | yaml_quote ]]
[% endif %]
[% endfor %]
[% endif %]
