[# Reference Table Model YAML Schema Template #]
version: 2

models:
  - name: [[ table_name ]]
    description: [[ (description or ("Reference table combining " ~ reference_hub_name ~ " with satellites")) | yaml_quote ]]
    config:
      tags: [% if model_tags is defined and model_tags is not none %][[ model_tags | quoted_list ]][% else %]['reference_table', 'raw_vault'][% endif +%]
