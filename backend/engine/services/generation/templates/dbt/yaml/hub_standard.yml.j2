[# Hub Model YAML Schema Template #]
version: 2

models:
  - name: [[ hub_name ]]
    description: [[ (description or (('Standard' if hub_type == 'standard' else 'Reference') ~ " hub for " ~ hub_name)) | yaml_quote ]]
    config:
      tags: [[ model_tags(['hub', 'raw_vault', (group | technical_name) if group else none]) ]]
    columns:
[% if hashkey %]
      - name: [[ hashkey.hashkey_name ]]
        description: "Hash key for [[ hub_name ]]"
        data_tests:
          - unique
          - not_null
[% endif %]
[% for bk in business_key_columns %]
      - name: [[ bk | yaml_scalar ]]
[% set docs = column_descriptions.get(bk) %]
        description: [[ (((docs.description or docs.source_description) if docs else none) or "Business key column") | yaml_quote ]]
        data_tests:
          - not_null
[% endfor %]
      - name: ldts
        description: "Load date timestamp"
      - name: rsrc
        description: "Record source"
