[# Snapshot Control V0 Model YAML Schema Template #]
version: 2

models:
  - name: [[ model_name ]]
    description: "Snapshot control table (base configuration)"
    config:
      tags: [% if model_tags %][[ model_tags ]][% else %]['snapshot_control', 'control'][% endif +%]
    columns:
      - name: sdts
        description: "Snapshot date timestamp"
        data_tests:
          - unique
          - not_null
