[# Snapshot Control V0 Model YAML Schema Template #]
[# v0_name: the model's name, as its SQL file is named #]
version: 2

models:
  - name: [[ v0_name ]]
    description: "Snapshot control table (base configuration)"
    config:
      tags: ['snapshot_control', 'control']
    columns:
      - name: sdts
        description: "Snapshot date timestamp"
        data_tests:
          - unique
          - not_null
