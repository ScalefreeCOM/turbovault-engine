[# Reference Hub Model YAML Schema Template #]
version: 2

models:
  - name: [[ hub_name ]]
    description: [[ (description or ("Reference hub for " ~ hub_name)) | yaml_quote ]]
    config:
      tags: ['hub', 'reference', 'raw_vault'[% if group %], '[[ group ]]'[% endif %]]
    columns:
[% for bk in business_key_columns %]
      - name: [[ bk ]]
[% set docs = column_descriptions.get(bk) %]
        description: [[ (((docs.description or docs.source_description) if docs else none) or "Business key column") | yaml_quote ]]
        data_tests:
          - unique
          - not_null
[% endfor %]
      - name: ldts
        description: "Load date timestamp"
      - name: rsrc
        description: "Record source"
