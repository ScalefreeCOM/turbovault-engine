[# Snapshot Control V1 Model YAML Schema Template #]
[# v1_name: the model's name, as its SQL file is named #]
version: 2

models:
  - name: [[ v1_name ]]
    description: "Snapshot control logic (retention patterns)"
    config:
      tags: [[ model_tags(['snapshot_control', 'control']) ]]
    columns:
      - name: [[ sdts_alias or 'sdts' ]]
        description: "Snapshot date timestamp"
        data_tests:
          - unique
          - not_null
[% for column in log_logic_columns %]
      - name: [[ column.name ]]
        description: "Snapshot logic: [[ column.intervals | map(attribute='name') | join(', ') ]]"
[% endfor %]
